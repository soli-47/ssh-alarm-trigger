[Unit]
Description=Log Event Sender
After=network.target log-collector.service
Wants=log-collector.service


[Service]
Type=simple
User=root
WorkingDirectory=/$PATH$/alarm-trigger
ExecStart=/usr/bin/python3 /$PATH$/alarm-trigger/sender.py
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target